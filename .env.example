# Zkopíruj do .env.local a doplň hodnoty ze Supabase (postup je v docs/supabase-setup.md).
# Oba údaje jsou určené pro prohlížeč a skončí v sestaveném frontendu.
VITE_SUPABASE_URL=https://TVUJ-PROJEKT.supabase.co
# Publishable key (sb_publishable_...), případně starší anon key.
# Secret key ani service_role key sem nikdy nepatří, obcházejí RLS.
VITE_SUPABASE_ANON_KEY=
